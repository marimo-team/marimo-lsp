{
  "name": "vscode-marimo",
  "displayName": "marimo",
  "version": "0.16.1",
  "description": "A marimo notebook extension for VS Code.",
  "categories": [
    "Data Science",
    "Notebooks"
  ],
  "repository": "https://github.com/marimo-team/marimo-lsp",
  "publisher": "marimo-team",
  "main": "./dist/extension.js",
  "scripts": {
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "patch-tsc": "effect-language-service patch",
    "typecheck-ci": "tsc",
    "build": "node scripts/run-turbo.mjs build:renderer build:extension",
    "build:extension": "esbuild --format=cjs --define:import.meta.env.DEV=false --platform=node --minify --external:vscode --external:../bundled/wasm/pyodide.js --bundle --sourcemap src/extension.ts src/wasmServer.ts --outdir=dist",
    "build:renderer": "vp build",
    "check": "vp check && node ./scripts/check-css-variables.mjs",
    "fix": "vp fmt && vp check --fix",
    "test": "vp test",
    "pretest:extension": "pnpm run build:extension",
    "test:extension": "vscode-test",
    "embed-sdist": "node scripts/embed-sdist.mjs",
    "build:wasm-lsp": "node scripts/run-turbo.mjs build:wasm-lsp:bundle",
    "build:wasm-lsp:bundle": "node scripts/build-wasm-lsp.mjs",
    "test:wasm-lsp": "node scripts/test-wasm-lsp.mjs",
    "verify:wasm-lsp": "node scripts/run-turbo.mjs build:wasm-lsp:bundle build:extension && pnpm test:wasm-lsp"
  },
  "devDependencies": {
    "@effect/platform": "^0.92.1",
    "@effect/platform-node": "^0.98.4",
    "@effect/tsgo": "0.31.0",
    "@effect/vitest": "^0.29.0",
    "@marimo-team/frontend": "link:../../marimo/frontend",
    "@marimo-team/openapi": "link:../../marimo/packages/openapi",
    "@marimo-team/smart-cells": "link:../../marimo/packages/smart-cells",
    "@oxlint/plugins": "^1.77.0",
    "@sentry/node": "^9.47.1",
    "@std/semver": "jsr:^1.0.8",
    "@std/toml": "jsr:^1.0.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "~1.108.0",
    "@types/vscode-notebook-renderer": "^1.72.4",
    "@vitest/coverage-v8": "4.1.10",
    "@vscode/debugprotocol": "^1.68.0",
    "@vscode/python-extension": "^1.0.6",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^3.1.0",
    "effect": "^3.22.1",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.11.1",
    "jest-mock-vscode": "^4.12.0",
    "jotai": "2.17.0",
    "mocha": "^11.8.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "posthog-node": "^5.47.9",
    "pyodide": "314.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tar": "^7.5.22",
    "tinyspy": "^4.0.4",
    "turbo": "^2.10.8",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vite-plus": "0.2.7",
    "vitest": "4.1.10",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageclient": "10.0.0",
    "vscode-languageserver-protocol": "^3.18.2"
  },
  "contributes": {
    "configuration": {
      "title": "Marimo",
      "properties": {
        "marimo.lsp.server": {
          "type": "string",
          "default": "wasm",
          "enum": [
            "wasm",
            "python",
            "custom"
          ],
          "markdownEnumDescriptions": [
            "Default. Run the self-contained language server using the bundled Pyodide runtime.",
            "Run the bundled Python language server in a uv-managed CPython environment.",
            "Run the command configured by `marimo.lsp.path`."
          ],
          "markdownDescription": "Select how the extension runs the marimo language server. This does not change the Python interpreter used by notebook kernels.",
          "scope": "window"
        },
        "marimo.lsp.path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Command and arguments used when `marimo.lsp.server` is `custom`, e.g., `[\"/path/to/marimo-lsp\"]`.",
          "scope": "window"
        },
        "marimo.experimental.wasmLsp": {
          "type": "boolean",
          "markdownDescription": "Deprecated setting retained so existing configurations receive migration guidance. It no longer affects which language server runs.",
          "markdownDeprecationMessage": "**Deprecated:** This setting no longer has any effect. Use `#marimo.lsp.server#` instead; select `python` to keep the previous native server.",
          "deprecationMessage": "Deprecated: This setting no longer has any effect. Use marimo.lsp.server instead; select python to keep the previous native server.",
          "scope": "window"
        },
        "marimo.uv.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `uv` binary, e.g., `/Users/me/.local/bin/uv`. Leave empty to use `uv` from the system PATH.",
          "scope": "resource"
        },
        "marimo.disableUvIntegration": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Disable uv integration features such as automatic package installation prompts.",
          "scope": "resource"
        },
        "marimo.telemetry": {
          "type": "boolean",
          "default": true,
          "description": "Anonymous usage data. This helps us prioritize features for the marimo VSCode extension."
        },
        "marimo.ruff.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a custom `ruff` binary, e.g., `/usr/local/bin/ruff`. Useful for offline environments. Leave empty to auto-discover or install via uv.",
          "scope": "resource"
        },
        "marimo.ty.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a custom `ty` binary, e.g., `/usr/local/bin/ty`. Useful for offline environments. Leave empty to auto-discover or install via uv.",
          "scope": "resource"
        },
        "marimo.disableManagedLanguageFeatures": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Disable marimo's managed Python language features (completions, diagnostics, formatting). When enabled, notebook cells use the standard `python` language ID and rely on external language servers.",
          "scope": "resource"
        },
        "marimo.notebookFileRoot": {
          "type": "string",
          "default": "${fileDirname}",
          "markdownDescription": "Controls the initial working directory of locally launched marimo kernels. Supports `${fileDirname}`, `${workspaceFolder}`, `~/some/path`, absolute paths, and paths relative to the notebook's containing workspace folder. Requires a kernel restart to take effect.",
          "scope": "resource"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "marimo_executeCode",
        "displayName": "Run Python in the marimo kernel",
        "modelDescription": "Run Python in a marimo notebook's live kernel. Pass the target notebook's URI as `notebookUri` (the notebook the user is working in). Each call runs in a scratchpad: the notebook's variables are in scope, but anything newly bound stays in the scratchpad. Use it to inspect state (e.g. print(df.head())) and to build the notebook. To durably create, edit, or run notebook cells, write Python that uses marimo's code mode: `import marimo._code_mode as cm` then `async with cm.get_context() as ctx: ...`. Call `help(cm)` for the current API. This tool is the execution channel for the `marimo-pair-vscode` skill, which documents how to inspect live state, explore data, prototype and debug code, drive the kernel, and make durable notebook changes safely — load that skill whenever you are working in a marimo notebook here, not only for durable edits.",
        "userDescription": "Run Python in a marimo notebook's kernel.",
        "toolReferenceName": "executeCode",
        "canBeReferencedInPrompt": true,
        "icon": "$(run)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "description": "Python to run in the notebook's kernel."
            },
            "notebookUri": {
              "type": "string",
              "description": "URI of the marimo notebook to run in (the notebook the user is working in)."
            }
          },
          "required": [
            "notebookUri",
            "code"
          ]
        }
      }
    ],
    "chatInstructions": [
      {
        "path": "./prompts/marimo.instructions.md"
      }
    ],
    "chatSkills": [
      {
        "path": "./skills/marimo-pair-vscode/SKILL.md"
      }
    ],
    "languages": [
      {
        "id": "mo-python",
        "aliases": [
          "Python (marimo)",
          "mo-python"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mo-python",
        "scopeName": "source.mo-python",
        "path": "./syntaxes/python.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "marimo",
        "label": "Marimo Debugger",
        "languages": [
          "python",
          "mo-python"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "python"
      },
      {
        "language": "mo-python"
      }
    ],
    "walkthroughs": [
      {
        "id": "marimo-getting-started",
        "title": "Get Started with marimo",
        "description": "Learn how to create and run reactive Python notebooks in VS Code with marimo.",
        "steps": [
          {
            "id": "check-prerequisites",
            "title": "Check Prerequisites",
            "description": "Ensure you have `uv` installed on your system. marimo uses `uvx` to run the language server and manage packages.\n\n[Install uv](https://docs.astral.sh/uv/getting-started/installation/)",
            "media": {
              "image": "images/getting-started.png",
              "altText": "marimo notebook interface"
            },
            "completionEvents": [
              "onCommand:marimo.newMarimoNotebook"
            ]
          },
          {
            "id": "start-tutorial",
            "title": "Start the Tutorial",
            "description": "Open one of our interactive tutorials to learn marimo's reactive programming model. Each tutorial is a marimo notebook you can edit and experiment with!\n\n[Open a Tutorial](command:marimo.openTutorial)\n\n[Watch YouTube Overview](https://www.youtube.com/watch?v=3N6lInzq5MI)",
            "media": {
              "markdown": "walkthroughs/start-tutorial.md"
            },
            "completionEvents": [
              "onCommand:marimo.openTutorial"
            ]
          },
          {
            "id": "create-notebook",
            "title": "Create a New Notebook",
            "description": "Ready to create your own notebook? Use the command palette to create a new marimo notebook.\n\n[Create New marimo Notebook](command:marimo.newMarimoNotebook)",
            "media": {
              "markdown": "walkthroughs/create-notebook.md"
            },
            "completionEvents": [
              "onCommand:marimo.newMarimoNotebook"
            ]
          },
          {
            "id": "keep-exploring",
            "title": "Keep Exploring!",
            "description": "marimo is reactive, reproducible, and reusable. Run a cell or interact with a UI element, and marimo automatically runs dependent cells. Learn more through our resources:\n\n- [Documentation](https://docs.marimo.io/)\n- [YouTube Channel](https://www.youtube.com/@marimo-team)\n- [Discord Community](http://marimo.io/discord)",
            "media": {
              "markdown": "walkthroughs/keep-exploring.md"
            },
            "completionEvents": []
          }
        ]
      }
    ],
    "notebooks": [
      {
        "type": "marimo-notebook",
        "displayName": "marimo Notebook",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.py"
          }
        ]
      }
    ],
    "notebookRenderer": [
      {
        "id": "marimo-renderer",
        "displayName": "Marimo Output Renderer",
        "entrypoint": "./dist/renderer.mjs",
        "mimeTypes": [
          "application/vnd.marimo.ui+json"
        ],
        "requiresMessaging": "always"
      }
    ],
    "commands": [
      {
        "command": "marimo.showMarimoMenu",
        "title": "Show marimo menu",
        "category": "marimo"
      },
      {
        "command": "marimo.showNotebookMenu",
        "title": "Show notebook menu",
        "shortTitle": "marimo",
        "category": "marimo",
        "icon": "images/small-icon.png",
        "enablement": "notebookType == 'marimo-notebook'"
      },
      {
        "command": "marimo.newMarimoNotebook",
        "title": "New marimo notebook",
        "shortTitle": "Marimo notebook",
        "category": "Create"
      },
      {
        "command": "marimo.openTutorial",
        "title": "Open tutorial",
        "category": "marimo"
      },
      {
        "command": "marimo.openOutlineView",
        "title": "Show outline",
        "shortTitle": "Outline",
        "category": "marimo",
        "icon": "$(list-unordered)",
        "enablement": "notebookType == 'marimo-notebook'"
      },
      {
        "command": "marimo.createSetupCell",
        "title": "Create setup cell",
        "category": "marimo",
        "enablement": "notebookType == 'marimo-notebook'"
      },
      {
        "command": "marimo.publishMarimoNotebook",
        "title": "Publish notebook…",
        "shortTitle": "Publish notebook",
        "category": "marimo",
        "enablement": "notebookType == 'marimo-notebook'"
      },
      {
        "command": "marimo.debugCell",
        "title": "Debug cell",
        "shortTitle": "Debug",
        "category": "marimo",
        "icon": "$(debug-alt)",
        "enablement": "notebookType == 'marimo-notebook'"
      },
      {
        "command": "marimo.hideCellCode",
        "title": "Hide Code",
        "category": "marimo",
        "icon": "$(eye-closed)",
        "enablement": "notebookType == 'marimo-notebook'"
      },
      {
        "command": "marimo.showCellCode",
        "title": "Show Code",
        "category": "marimo",
        "icon": "$(eye)",
        "enablement": "notebookType == 'marimo-notebook'"
      },
      {
        "command": "marimo.disableCell",
        "title": "Disable Cell",
        "category": "marimo",
        "icon": "$(circle-slash)",
        "enablement": "notebookType == 'marimo-notebook'"
      },
      {
        "command": "marimo.enableCell",
        "title": "Enable Cell",
        "category": "marimo",
        "icon": "$(circle-large-outline)",
        "enablement": "notebookType == 'marimo-notebook'"
      },
      {
        "command": "marimo.openSession",
        "title": "Open Notebook",
        "category": "marimo",
        "icon": "$(go-to-file)"
      },
      {
        "command": "marimo.restartSession",
        "title": "Restart Kernel",
        "category": "marimo",
        "icon": "$(debug-restart)"
      },
      {
        "command": "marimo.shutdownSession",
        "title": "Shut Down Kernel",
        "category": "marimo",
        "icon": "$(close)"
      },
      {
        "command": "marimo.shutdownAllSessions",
        "title": "Shut Down All Kernels",
        "category": "marimo",
        "icon": "$(trash)"
      },
      {
        "command": "marimo.refreshPackages",
        "title": "Refresh packages",
        "category": "marimo",
        "icon": "$(refresh)"
      },
      {
        "command": "marimo.runStale",
        "title": "Run stale cells",
        "shortTitle": "Run stale",
        "category": "marimo",
        "icon": "$(play)",
        "enablement": "notebookType == 'marimo-notebook'"
      },
      {
        "command": "marimo.restartKernel",
        "title": "Restart notebook kernel",
        "shortTitle": "Restart Kernel",
        "category": "marimo",
        "enablement": "notebookType == 'marimo-notebook'"
      },
      {
        "command": "marimo.openAsMarimoNotebook",
        "title": "Open as marimo notebook",
        "category": "marimo",
        "icon": "images/small-icon.png"
      },
      {
        "command": "marimo.restartLsp",
        "title": "Restart marimo language server (marimo-lsp)",
        "shortTitle": "Restart marimo-lsp"
      },
      {
        "command": "marimo.showDiagnostics",
        "title": "Show diagnostics",
        "category": "marimo"
      },
      {
        "command": "marimo.reportIssue",
        "title": "Report an issue or suggest a feature",
        "category": "marimo"
      },
      {
        "command": "marimo.exportStaticHTML",
        "title": "Export static HTML",
        "shortTitle": "Export static HTML",
        "category": "marimo",
        "enablement": "notebookType == 'marimo-notebook'"
      },
      {
        "command": "marimo.updateCellMetadata",
        "title": "Update cell metadata",
        "category": "marimo"
      },
      {
        "command": "marimo.updateActivePythonEnvironment",
        "title": "Set Python interpreter to match notebook kernel",
        "category": "marimo",
        "enablement": "notebookType == 'marimo-notebook'"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "marimo-explorer",
          "title": "marimo",
          "icon": "images/small-icon.png"
        }
      ]
    },
    "views": {
      "marimo-explorer": [
        {
          "id": "marimo-explorer-sessions",
          "name": "Sessions"
        },
        {
          "id": "marimo-explorer-variables",
          "name": "Variables"
        },
        {
          "id": "marimo-explorer-datasources",
          "name": "Datasources"
        },
        {
          "id": "marimo-explorer-packages",
          "name": "Packages"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "marimo.showMarimoMenu",
          "when": "never"
        },
        {
          "command": "marimo.openSession",
          "when": "never"
        },
        {
          "command": "marimo.restartSession",
          "when": "never"
        },
        {
          "command": "marimo.shutdownSession",
          "when": "never"
        },
        {
          "command": "marimo.shutdownAllSessions",
          "when": "never"
        },
        {
          "command": "marimo.refreshPackages",
          "when": "never"
        },
        {
          "command": "marimo.updateCellMetadata",
          "when": "never"
        },
        {
          "command": "marimo.disableCell",
          "when": "never"
        },
        {
          "command": "marimo.enableCell",
          "when": "never"
        }
      ],
      "file/newFile": [
        {
          "command": "marimo.newMarimoNotebook",
          "group": "notebook"
        }
      ],
      "view/title": [
        {
          "command": "marimo.shutdownAllSessions",
          "when": "view == marimo-explorer-sessions && marimo.hasLiveSessions",
          "group": "navigation"
        },
        {
          "command": "marimo.refreshPackages",
          "when": "view == marimo-explorer-packages",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "marimo.restartSession",
          "when": "view == marimo-explorer-sessions && viewItem == marimoSession",
          "group": "inline@1"
        },
        {
          "command": "marimo.shutdownSession",
          "when": "view == marimo-explorer-sessions && viewItem == marimoSession",
          "group": "inline@2"
        },
        {
          "command": "marimo.restartSession",
          "when": "view == marimo-explorer-sessions && viewItem == marimoSession",
          "group": "session@1"
        },
        {
          "command": "marimo.shutdownSession",
          "when": "view == marimo-explorer-sessions && viewItem == marimoSession",
          "group": "session@2"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "marimo.runStale",
          "when": "notebookType == 'marimo-notebook' && marimo.notebook.hasStaleCells",
          "group": "navigation@1"
        },
        {
          "command": "marimo.restartKernel",
          "when": "notebookType == 'marimo-notebook'",
          "group": "navigation@2"
        },
        {
          "command": "marimo.openOutlineView",
          "when": "notebookType == 'marimo-notebook'",
          "group": "navigation@3"
        },
        {
          "command": "marimo.showNotebookMenu",
          "when": "notebookType == 'marimo-notebook'",
          "group": "navigation@4"
        }
      ],
      "notebook/cell/title": [
        {
          "command": "marimo.hideCellCode",
          "when": "notebookType == 'marimo-notebook' && notebookCellType == 'code' && !notebookCellInputIsCollapsed",
          "group": "3_edit@1"
        },
        {
          "command": "marimo.showCellCode",
          "when": "notebookType == 'marimo-notebook' && notebookCellType == 'code' && notebookCellInputIsCollapsed",
          "group": "3_edit@1"
        },
        {
          "command": "marimo.disableCell",
          "when": "notebookType == 'marimo-notebook' && notebookCellType == 'code'",
          "group": "3_edit@2"
        }
      ],
      "editor/title": [
        {
          "command": "marimo.openAsMarimoNotebook",
          "when": "resourceLangId == python && !notebookType && marimo.isPythonFileMarimoNotebook",
          "group": "navigation"
        },
        {
          "command": "marimo.openOutlineView",
          "when": "notebookType == 'marimo-notebook' && config.notebook.globalToolbar != true",
          "group": "navigation@5"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "marimo-explorer-sessions",
        "contents": "No live sessions. Run a cell in a marimo notebook to start one."
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "ms-python.python"
  ],
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.108.0"
  },
  "packageManager": "pnpm@11.18.0",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Running marimo notebooks executes Python code from the workspace."
    }
  }
}
